# Build-time environment for production builds.
#
# These two values are PUBLIC by design and cannot be hidden: they are
# NEXT_PUBLIC_* variables, so Next.js inlines them into the client bundle and
# anyone can read them from DevTools. Committing them is therefore not a leak —
# access control lives in Supabase Row Level Security, not in this key.
#
# Committing them also makes Cloudflare builds work without any dashboard
# configuration. Never put real secrets in this file (service_role key, DB
# password, JWT secret) — those must live in the Worker's runtime secrets.
NEXT_PUBLIC_SUPABASE_URL=https://lbhaqrneluvexzhlbckk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_d2aq8qQiu2cNhSr4jBmS-w_opW4D91x

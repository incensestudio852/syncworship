# Cloudflare Pages headers.
# Hashed Next.js assets are immutable — cache them forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# OCR/PDF runtime assets are versioned by pdfjs-dist / tesseract.js on the
# client, but the filenames are stable, so cache them for a day and revalidate.
/tesseract/*
  Cache-Control: public, max-age=86400
/tesseract-core/*
  Cache-Control: public, max-age=86400
/tessdata/*
  Cache-Control: public, max-age=86400
/cmaps/*
  Cache-Control: public, max-age=86400
/wasm/*
  Cache-Control: public, max-age=86400
/standard_fonts/*
  Cache-Control: public, max-age=86400

# The PDF worker is a single stable filename.
/pdf.worker.min.mjs
  Cache-Control: public, max-age=86400

# The app shell must always revalidate so a deploy is picked up immediately.
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
